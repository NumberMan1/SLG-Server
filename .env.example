# Optional. Leave empty to use Podman's current connection.
SLG_PODMAN_MACHINE=
SLG_PODMAN_CONNECTION=

# The default network is created automatically. Set this to reuse an existing network.
SLG_PODMAN_NETWORK=slg-dev

# Host loopback ports. Unity gets the TCP port from the login response.
SLG_GATEWAY_HTTP_PORT=8080
SLG_GATEWAY_TCP_PORT=19090
# 游戏服回收离线名额的等待时间，单位为秒。
# SLG_WORLD_IDLE_SECONDS=60

# 每个登录服实例的并发保护与可选注册速率，VS Code 和 Podman 共用。
# SLG_LOGIN_CONCURRENCY=16
# SLG_REGISTER_CONCURRENCY=4
# SLG_REGISTER_RATE_PER_SECOND=0
# Direct gateway runs can serve an uncompressed Unity Web build at the same origin.
# SLG_WEB_ROOT='/absolute/path/to/Frontier-Web'

# Use endpoints as seen from the SLG containers.
# SLG_MYSQL_DSN='slg:your-db-password@tcp(gm-mysql:3306)/slg'
SLG_REDIS_MODE=cluster
# Optional for the Redis Cluster on gm-dev or slg-dev. Set this for other deployments.
# SLG_REDIS_ADDRESSES=redis-1:6379,redis-2:6379,redis-3:6379
# Set this explicitly when sharing .env with the gm-dev VS Code launch profiles:
# SLG_REDIS_ADDRESSES=gm-redis-1:6379,gm-redis-2:6379,gm-redis-3:6379
# SLG_REDIS_PASSWORD='your-local-redis-password'
SLG_ETCD_ENDPOINTS=http://gm-etcd-1:2379,http://gm-etcd-2:2379,http://gm-etcd-3:2379

# Optional. Separate these namespaces when sharing middleware across environments.
# SLG_ETCD_PREFIX=/slg/services
# SLG_REDIS_KEY_PREFIX=slg:login

# Provision a local account when starting with scripts/dev.sh.
SLG_DEMO_ACCOUNT=demo
# SLG_DEMO_PASSWORD='your-local-password'
